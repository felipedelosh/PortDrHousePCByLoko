│
├── Docs/
│   ├── PROJECT.md
│   ├── ARCHITECTURE.md
│   ├── CLASS_MAPPING.md
│   ├── METHOD_MAPPING.md
│   ├── GAME_FLOW.md
│   └── RESOURCE_FORMATS.md
│
├── INPUT/
│   └── DrHouse.jar
│
├── TOOLS/
│   └── vineflower-1.12.0.jar
│
├── DECOMPILED/
│   └── VINEFLOWER/
│
├── src/
│   ├── main/
│   │   ├── java/
│   │   └── resources/
│   │
│   └── test/
│       └── java/
│
├── README.md
├── AGENTS.md
└── .gitignore

Ejecutar el descompilador:

java -jar .\TOOLS\vineflower-1.12.0.jar --rename-members=true --folder .\INPUT\DrHouse.jar .\DECOMPILED\VINEFLOWER


